# ==============================================================================
# QUBIX (AI DocVerify) - Environment Variables Configuration Reference
# ==============================================================================
# Copy relevant variables to your hosting platforms (Vercel, Render, Railway, etc.)
# DO NOT COMMIT REAL SECRETS OR SENSITIVE API KEYS TO GIT REPOSITORIES.

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Set in Vercel Project Settings > Environment Variables)
# ------------------------------------------------------------------------------
# Public API gateway URL pointing to your deployed backend (must include /api/v1)
VITE_API_URL=https://your-backend-api-domain.com/api/v1

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Set in Render / Railway / Fly.io / VPS Environment)
# ------------------------------------------------------------------------------
# Application Identity & Mode
APP_NAME="QUBIX"
APP_ENV=production
DEBUG=False
API_V1_PREFIX=/api/v1

# CORS Origins (Permit your frontend domain; all *.vercel.app domains are also auto-allowed)
CORS_ORIGINS=["https://your-frontend-app.vercel.app","http://localhost:5173"]

# Database Connection
# Local development: SQLite
DATABASE_URL=sqlite:///./docverify.db
# Production (Persistent Cloud): PostgreSQL (Supabase, Neon, AWS RDS, Railway Postgres)
# DATABASE_URL=postgresql://user:password@host:5432/qubix_db

# Security & Secrets (Must be at least 32 characters long)
SECRET_KEY=replace-with-a-secure-random-32-character-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AES-256 Storage Encryption Key (Fernet 32-byte urlsafe base64 key)
# Generate key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-valid-fernet-base64-encryption-key-for-aes256==

# Document Storage & Retention Paths
STORAGE_ROOT=../storage
MAX_UPLOAD_SIZE_BYTES=15728640 # 15 MB
ALLOWED_MIME_TYPES=["application/pdf","image/jpeg","image/png"]
ALLOWED_EXTENSIONS=[".pdf",".jpg",".jpeg",".png"]

# Verification & Rule Parameters
EXPIRY_WARNING_DAYS=60
SIMILARITY_THRESHOLD=0.82

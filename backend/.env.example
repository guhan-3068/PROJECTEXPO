# QUBIX Backend Environment Configuration

# Application Identity & Mode
APP_NAME="QUBIX"
APP_ENV=production
DEBUG=False
API_V1_PREFIX=/api/v1

# CORS Origins (Comma-separated or JSON list of permitted frontend domains)
# Example: CORS_ORIGINS=["https://your-qubix-app.vercel.app","http://localhost:5173"]
CORS_ORIGINS=["https://your-qubix-frontend.vercel.app","http://localhost:5173"]

# Database Connection
# Local development default: SQLite
DATABASE_URL=sqlite:///./docverify.db
# Production recommended: Managed PostgreSQL (e.g. Supabase, Neon, AWS RDS)
# DATABASE_URL=postgresql://user:password@host:5432/qubix_db

# Security & Authentication (Generate random 32+ char string in production)
SECRET_KEY=replace-with-a-secure-random-32-character-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AES-256 Storage Encryption Key (Fernet 32-byte urlsafe base64 key)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-valid-fernet-base64-encryption-key-for-aes256==

# Storage & File Uploads
# Local/Persistent: ../storage
# Serverless/Vercel ephemeral: /tmp/storage
STORAGE_ROOT=../storage
MAX_UPLOAD_SIZE_BYTES=15728640 # 15 MB (Note: Vercel serverless request body is capped at 4.5 MB)
ALLOWED_MIME_TYPES=["application/pdf","image/jpeg","image/png"]
ALLOWED_EXTENSIONS=[".pdf",".jpg",".jpeg",".png"]

# Verification & Rule Parameters
EXPIRY_WARNING_DAYS=60
SIMILARITY_THRESHOLD=0.82

# Application Configuration
APP_NAME="DocVerify AI"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database Connection (Default uses SQLite; set PostgreSQL URI for production)
DATABASE_URL=sqlite:///./docverify.db
# DATABASE_URL=postgresql://docverify:securepassword@localhost:5432/docverify_db

# Security & Secrets (Generate strong random keys for production)
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars-long-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Document Encryption Key (AES-256 base64 or 32-byte urlsafe key)
ENCRYPTION_KEY=s_8lP7Xm9Z2kH5jV8yR4bW1qT6uI3oE0eL9pA2sD5fG=

# Storage Paths
STORAGE_ROOT=../storage
MAX_UPLOAD_SIZE_BYTES=15728640 # 15 MB
ALLOWED_MIME_TYPES=["application/pdf", "image/jpeg", "image/png"]

# Expiry Horizon Configuration
EXPIRY_WARNING_DAYS=60 # Flag documents expiring within 60 days as EXPIRING_SOON
